# Solana RPC URL (use Devnet for testing, Mainnet for production)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Path to server keypair (generate with: solana-keygen new -o server-keypair.json)
# Server needs SOL to pay for transaction fees
SERVER_KEYPAIR_PATH=./server-keypair.json

# WebSocket Port
PORT=3001
